{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saranwak-wedding-invitation",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  }
  /*
  // Tambahkan binding D1 setelah database dibuat:
  // npx wrangler d1 create saranwak_wedding_db
  ,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saranwak_wedding_db",
      "database_id": "<MASUKKAN_DATABASE_ID_D1>"
    }
  ]
  */
}
