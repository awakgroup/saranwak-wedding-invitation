{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saranwak-wedding-invitation",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saranwak_wedding_db",
      "database_id": "4bfa3d32-6823-4566-9f27-e3edd533f3f3"
    }
  ]
}
